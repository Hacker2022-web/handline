{
  "name": "handline",
  "version": "1.0.0",
  "description": "Personal gesture communicator with local and cloud Gemma verification",
  "scripts": {
    "dev": "concurrently -k -n bridge,web \"tsx watch server/index.ts\" \"vite\"",
    "setup:assets": "node scripts/prepare-assets.mjs",
    "setup:model": "ollama pull gemma4:12b",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "headroom-ai": "^0.42.0",
    "idb": "^8.0.4",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true
}
